# ============================================================
# .gitignore — PSC Plasma Simulation project
# ============================================================

# ---- Build directories (CMake, ninja, make) ----
/build/
src/build/
*.o
*.a
*.so
*.so.*
*.dylib
*.exe
*.bin
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.cmake
install_manifest.txt
CTestTestfile.cmake
_CPack_Packages/
Testing/
compile_commands.json

# ---- Generated images & plots (analysis output) ----
# These are regenerated by the analysis scripts — do NOT track
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.svg
*.eps
*.webp
*.ico

# Exception: libmrc documentation images (part of upstream PSC)
!src/libmrc/doc/**/*.png

# Exception: libmrc test reference data (regression tests)
!src/libmrc/tests/reference_results/**/*.dump
!src/libmrc/tests/reference_results/**/*.xdmf
!src/libmrc/tests/reference_results/**/*.log

# ---- Simulation data output (large binary files) ----
*.bp/
*.bp
*.h5
*.hdf5
*.mrc
*.sst
*.dump
*.xdmf
*.dat
*.npy
*.npz
*.pkl
*.pickle
*.csv
checkpoint_*/

# ---- Analysis output directories ----
plasma_results_temp/
CodeforAnalisysAdios2/
CodeforAnalisys/anisotropy_plots/
CodeforAnalisys/field_images/
CodeforAnalisys/mirror_plots/
CodeforAnalisys/diamagnetic_plots/
CodeforAnalisys/spectral_plots/
CodeforAnalisys/prt_plots/
CodeforAnalisys/fancy_vdf_plots/
CodeforAnalisys/phase_space_plots/
CodeforAnalisys/validation_plots/
reconnection_local_output/

# ---- Local-only simulations and analysis ----
# Reduced workstation variants, their documentation, run data, and diagnostics
# are intentionally kept outside the shared repository.
/corridas_locales/
/runs_local/
/CodeforAnalisysLocal/
/src/*_local.cxx
/src/*local*.hxx
/src/*_local.sh
/src/*LOCAL*.md
/src/*local*.md
/src/psc_mirror_maxwellian_2k.cxx
/src/psc_mirror_maxwellian_pauli.cxx
/src/psc_reconnection_mini.cxx

# ---- Python ----
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
.eggs/
*.egg
.Python

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.codex
.cache/

# ---- Jupyter Notebooks (checkpoints) ----
.ipynb_checkpoints/

# ---- PDFs / reports / slide decks ----
*.pdf
Informes/
informes/
Presentaciones/
presentaciones/
Reports/
reports/
slides/
*.pptx
*.ppt
*.docx
*.doc
*.xlsx
*.xls

# ---- LaTeX / TeX build artifacts ----
*.tex
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
_minted-*/
*.pygtex
*.pygstyle
build_pdf.py

# ---- SLURM / HPC job files ----
*.out.slurm
slurm-*.out
job_*.sh

# ---- OS / System files ----
.DS_Store
Thumbs.db
desktop.ini
*.log

# ---- Archives ----
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.7z
*.rar

# ---- Analysis results are NOT versioned ----
# Figures, GIFs, per-step maps and diagnostic tables are all regenerable from the
# raw run data via the CodeforAnalisys/Makefile targets. Keeping them in git made
# the history grow into the gigabytes, so the whole tree stays out.
/analysis_results/
/CodeforAnalisys/downloads/

# ---- graphify knowledge graph (generated) ----
# Rebuilt locally with `graphify update .`; contains an AST cache, a query timestamp
# that changes on every query, and absolute paths specific to each machine.
/graphify-out/

# ---- Personal notes / assistant memory ----
/memory/
.claude/settings.local.json
*.graphify-bak

# Older/draft copies of the psc-case-integrity skill. The canonical version that
# Claude Code actually loads lives in .claude/skills/psc-case-integrity/.
/.claude/psc-case-integrity/
/.claude/skills-draft-psc-case-integrity/
